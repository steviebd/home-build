# Home Weather Monitoring System Configuration

# Grafana Cloud Configuration
# Get these values from your Grafana Cloud account:
# 1. Go to Grafana Cloud Portal > Prometheus card > Details
# 2. Copy the exact values from the prometheus.yml snippet they provide

# Example format (replace with your actual values):
GRAFANA_CLOUD_PUSH_URL=https://prometheus-prod-XX-prod-region.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=1234567
GRAFANA_CLOUD_PASSWORD=glc_your_long_encoded_token_here

# Device location tag
DEVICE_DB_LOCATION=home

# Job name configurable 
PROMETHEUS_JOB_NAME=home-sensors

# =============================================================================
# DEPLOYMENT INSTRUCTIONS:
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Edit .env with your actual Grafana Cloud credentials from the portal
# 3. Deploy: docker-compose up -d
