# Home Weather Monitoring System Configuration

# =============================================================================
# SETUP MODE: Choose one configuration below
# =============================================================================

# FOR GRAFANA CLOUD (recommended - no local infrastructure needed)
# Get these values from your Grafana Cloud account:
# 1. Go to Grafana Cloud Portal > Prometheus card > Details
# 2. Copy the Push URL, Username, and Password
GRAFANA_CLOUD_PUSH_URL=https://prometheus-prod-10-prod-us-central-0.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=your_grafana_cloud_username
GRAFANA_CLOUD_PASSWORD=your_grafana_cloud_password

# FOR LOCAL INFLUXDB (legacy setup - requires local database.env file)
# INFLUX_DB_BUCKET=your_bucket_name
# INFLUX_DB_TOKEN=your_influx_token
# INFLUX_DB_ORG=your_org_name

# Device location tag (used in both setups)
DEVICE_DB_LOCATION=home

# =============================================================================
# DEPLOYMENT INSTRUCTIONS:
# =============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. Choose deployment mode:
#    - Grafana Cloud: docker-compose --profile cloud up -d
#    - Local setup:   docker-compose --profile local up -d
