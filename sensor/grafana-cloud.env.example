# Grafana Cloud Configuration
# Get these values from your Grafana Cloud account

# Option 1: Using Push Gateway (recommended for simplicity)
GRAFANA_CLOUD_PUSH_URL=https://prometheus-prod-10-prod-us-central-0.grafana.net/api/prom/push
GRAFANA_CLOUD_USERNAME=your_grafana_cloud_username
GRAFANA_CLOUD_PASSWORD=your_grafana_cloud_password

# Option 2: Using Metrics endpoint (alternative)
GRAFANA_CLOUD_METRICS_URL=https://prometheus-prod-10-prod-us-central-0.grafana.net/api/prom/push
GRAFANA_CLOUD_METRICS_USERNAME=your_metrics_username
GRAFANA_CLOUD_METRICS_PASSWORD=your_metrics_password

# Device location tag
DEVICE_DB_LOCATION=home

# Instructions:
# 1. Copy this file to grafana-cloud.env
# 2. Replace the placeholder values with your actual Grafana Cloud credentials
# 3. Find your credentials in Grafana Cloud Portal > Prometheus card > Details
